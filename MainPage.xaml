<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.MainPage"
             Title="ShopApp - EF Core Demo"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Tienda de Productos EF Core"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1F2937" />

            <!-- Botones de Consultas LINQ -->
            <Button Text="1. Productos Categoría 'Computadoras'"
                    Clicked="OnGetComputersClicked"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    CornerRadius="8" />

            <Button Text="2. Productos con Precio > $1000"
                    Clicked="OnGetExpensiveProductsClicked"
                    BackgroundColor="#059669"
                    TextColor="White"
                    CornerRadius="8" />

            <Button Text="3. Categoría del Producto más Caro"
                    Clicked="OnGetCategoryMostExpensiveClicked"
                    BackgroundColor="#D97706"
                    TextColor="White"
                    CornerRadius="8" />

            <Button Text="Mostrar Todos los Productos"
                    Clicked="OnGetAllProductsClicked"
                    BackgroundColor="#4B5563"
                    TextColor="White"
                    CornerRadius="8" />

            <BoxView HeightRequest="1" Color="#D1D5DB" Margin="0,10"/>

            <Label x:Name="LblResultadoTitulo"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#1F2937" />

            <Label x:Name="LblInfoEspecial"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="#D97706"
                   IsVisible="False" />

            <!-- Lista de Resultados -->
            <CollectionView x:Name="CvProductos" HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,4" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Precio, StringFormat='${0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="#059669"/>
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Descripcion}" FontSize="13" TextColor="#6B7280"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
