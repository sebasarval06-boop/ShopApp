<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Views.CategoryPage"
             Title="Categorías">

    <VerticalStackLayout
        Padding="30"
        Spacing="20">

        <Label
            Text="SHOP APP"
            FontSize="30"
            HorizontalOptions="Center" />

        <Label
            Text="Categorías"
            FontSize="24"
            HorizontalOptions="Center" />

        <Button
            Text="Ir a Clientes"
            Clicked="OnClientesClicked" />

        <Button
            Text="Ir a Productos"
            Clicked="OnProductosClicked" />

    </VerticalStackLayout>

</ContentPage>