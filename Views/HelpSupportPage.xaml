<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ShopApp.Views"
             x:Class="ShopApp.Views.HelpSupportPage"
             Title="HelpSupportPage">



    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="15">

        <!-- Muestra el número de visitas pendientes -->
        <Label Text="{Binding VisitasPendientes, Mode=OneWay}"
               FontSize="30"
               FontAttributes="Bold" />

        <!-- Botón para actualizar el valor -->
        <Button Grid.Row="1"
                Text="Actualizar" 
                Clicked="Button_Clicked" />

        <Button
    Text="Ver detalle de productos"
    BackgroundColor="#2563EB"
    TextColor="White"
    Clicked="OnVerDetalleClicked" />

        <!-- Lista de Clientes -->
        <CollectionView Grid.Row="2"
                        SelectionMode="Single"
                        SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                        ItemsSource="{Binding Clients, Mode=OneWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding Nombre}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding Direccion}" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>